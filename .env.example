# ============================================================================
# RedactionTool Environment Configuration
# Copy this file to .env and update with your values
# ============================================================================

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME=RedactionTool
APP_ENV=production  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ----------------------------------------------------------------------------
# Service Ports
# ----------------------------------------------------------------------------
UI_PORT=8501
API_PORT=8000
REDIS_PORT=6379
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ----------------------------------------------------------------------------
# Streamlit UI Settings
# ----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
STREAMLIT_SERVER_FILE_WATCHER_TYPE=none

# ----------------------------------------------------------------------------
# API Settings
# ----------------------------------------------------------------------------
API_KEY=your-secret-api-key-change-this-in-production
CORS_ORIGINS=*  # Comma-separated list, e.g., http://localhost:3000,https://example.com
API_RATE_LIMIT=100  # Requests per minute
API_TIMEOUT=300  # Seconds

# ----------------------------------------------------------------------------
# OCR Settings
# ----------------------------------------------------------------------------
TESSERACT_CMD=tesseract
TESSERACT_LANG=eng+hin  # Language codes: eng, hin, fra, deu, etc.
TESSERACT_CONFIG=--oem 3 --psm 6  # OCR Engine Mode and Page Segmentation Mode

# ----------------------------------------------------------------------------
# Performance Settings
# ----------------------------------------------------------------------------
MAX_WORKERS=4  # Number of parallel workers
BATCH_SIZE=100  # Batch size for processing
CHUNK_SIZE=10000  # Chunk size for streaming
CACHE_ENABLED=true
CACHE_SIZE=1000  # Number of patterns to cache
CACHE_TTL=3600  # Cache time-to-live in seconds

# ----------------------------------------------------------------------------
# Redis Cache Settings
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave empty if no password
REDIS_MAXMEMORY=512mb
REDIS_MAX_CONNECTIONS=50

# ----------------------------------------------------------------------------
# Security & Privacy Settings
# ----------------------------------------------------------------------------
ENABLE_AUDIT_LOG=true
HASH_DOCUMENTS=true  # Hash document IDs in logs
HASH_ENTITY_TEXT=true  # Hash entity text in logs
MASK_FILE_PATHS=true  # Mask file paths in logs
RETENTION_DAYS=90  # Audit log retention period

# ----------------------------------------------------------------------------
# Resource Limits (Docker)
# ----------------------------------------------------------------------------
# UI Service
UI_CPU_LIMIT=2.0
UI_MEMORY_LIMIT=4G
UI_CPU_RESERVATION=0.5
UI_MEMORY_RESERVATION=1G

# API Service
API_CPU_LIMIT=4.0
API_MEMORY_LIMIT=8G
API_CPU_RESERVATION=1.0
API_MEMORY_RESERVATION=2G

# ----------------------------------------------------------------------------
# File Upload Limits
# ----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
MAX_BATCH_FILES=1000
ALLOWED_EXTENSIONS=txt,pdf,docx,png,jpg,jpeg,tiff,mp4,avi,mov

# ----------------------------------------------------------------------------
# Model Settings
# ----------------------------------------------------------------------------
SPACY_MODEL=en_core_web_sm
SPACY_MULTILINGUAL_MODEL=xx_ent_wiki_sm
PRESIDIO_ANALYZER_ENGINE=default
CONFIDENCE_THRESHOLD=0.5

# ----------------------------------------------------------------------------
# Database Settings (if using persistent storage)
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/redaction_db
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=0

# ----------------------------------------------------------------------------
# Cloud Storage Settings (optional)
# ----------------------------------------------------------------------------
# AWS S3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=redaction-uploads
# S3_OUTPUT_BUCKET=redaction-output

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_CONTAINER_NAME=redaction

# Google Cloud Storage
# GCP_PROJECT_ID=your-project-id
# GCS_BUCKET=redaction-uploads
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ----------------------------------------------------------------------------
# Monitoring & Observability (optional)
# ----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ----------------------------------------------------------------------------
# Email Notifications (optional)
# ----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=admin@example.com

# ----------------------------------------------------------------------------
# Deployment Settings
# ----------------------------------------------------------------------------
DEPLOYMENT_TYPE=local  # local, docker, kubernetes, cloud
DOMAIN_NAME=localhost
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
ENABLE_PARALLEL_PROCESSING=true
ENABLE_PATTERN_CACHING=true
ENABLE_MEMORY_TRACKING=true
ENABLE_BATCH_PROCESSING=true
ENABLE_BENCHMARK_MODE=false

# ----------------------------------------------------------------------------
# Development Settings
# ----------------------------------------------------------------------------
DEBUG_MODE=false
DEV_AUTO_RELOAD=false
DEV_CORS_ALL_ORIGINS=false
PROFILING_ENABLED=false

# ============================================================================
# EXTENSIBILITY FRAMEWORK SETTINGS
# ============================================================================

# ----------------------------------------------------------------------------
# Plugin System
# ----------------------------------------------------------------------------
ENABLE_PLUGINS=true
PLUGINS_DIR=plugins/detectors
PLUGINS_AUTO_DISCOVER=true
PLUGINS_DEFAULT_PRIORITY=3
PLUGINS_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------------------
# Language Packs
# ----------------------------------------------------------------------------
ENABLE_LANGUAGE_PACKS=true
LANGUAGES_DIR=plugins/languages
LANGUAGES_AUTO_DISCOVER=true

# ----------------------------------------------------------------------------
# LLM Providers
# ----------------------------------------------------------------------------
# Enable LLM-based context-aware detection
ENABLE_LLM=false

# Default LLM provider: openai, anthropic, ollama
LLM_PROVIDER=openai

# LLM response caching
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600
LLM_CACHE_CAPACITY=1000

# Rate limiting (requests per minute)
LLM_RATE_LIMIT=10

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=1000

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_MAX_TOKENS=1024

# Ollama Configuration (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:13b
OLLAMA_TIMEOUT=60

# ----------------------------------------------------------------------------
# Enhanced Ensemble Detector
# ----------------------------------------------------------------------------
# Enable base providers
USE_NER=true
USE_REGEX=true
USE_PRESIDIO=true

# Enable extensions (overrides base detector)
USE_ENHANCED_DETECTOR=true
ENHANCED_DETECTOR_ENABLE_PLUGINS=true
ENHANCED_DETECTOR_ENABLE_LLM=false

# Detection thresholds
MIN_CONFIDENCE=0.0

# ----------------------------------------------------------------------------
# Extensions API
# ----------------------------------------------------------------------------
# Enable extension management API endpoints
EXTENSIONS_API_ENABLED=true

# Require authentication for extension endpoints
EXTENSIONS_API_REQUIRE_AUTH=true

# Allow plugin upload via API (security consideration)
EXTENSIONS_API_ALLOW_UPLOAD=false

# Max upload size for plugins/language packs (MB)
EXTENSIONS_MAX_UPLOAD_SIZE_MB=10

# ----------------------------------------------------------------------------
# Extension Monitoring
# ----------------------------------------------------------------------------
# Log plugin execution
LOG_PLUGIN_EXECUTION=true

# Monitor plugin performance
MONITOR_PLUGIN_PERFORMANCE=true

# Slow plugin threshold (milliseconds)
SLOW_PLUGIN_THRESHOLD_MS=100

# Track LLM costs
TRACK_LLM_COSTS=true
